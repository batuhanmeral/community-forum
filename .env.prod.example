# ──────────────────────────────────────────────
# docker-compose.prod.yml — copy to .env and edit
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# ──────────────────────────────────────────────

# Django
# >= 50 chars; generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# "backend" must stay in the list: the compose healthcheck sends Host: backend, else nginx never starts
ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO
# Origin(s) the SPA is served from (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
# Set True once TLS is terminated in front of nginx
SECURE_SSL_REDIRECT=False
# Refresh-token cookie is Secure; browsers accept it on http://localhost, set False only for plain-HTTP tests on another host
AUTH_COOKIE_SECURE=True
# Reverse proxies in front of Django: 1 = nginx only, 2 = TLS edge proxy + nginx
NUM_PROXIES=1

# PostgreSQL
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=change-me-strong-password
# Seconds a worker keeps its DB connection open (0 disables); Postgres max_connections must cover workers x containers
DB_CONN_MAX_AGE=60

# Two-step verification (TOTP). Leave empty to keep it off. Secrets are Fernet-encrypted with this key;
# losing it locks every enrolled user out, so back it up. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate: put the new key first ("new,old"), run `manage.py rotate_mfa_keys`, then drop the old one.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Nexus

# Media storage: "filesystem" keeps uploads on the nexus_media volume. "s3" uses an external
# S3-compatible bucket (AWS S3, Cloudflare R2, ...) served through MEDIA_BASE_URL; see the README
# ("Object storage"). Never commit real keys.
STORAGE_BACKEND=filesystem
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
# Public URL objects are served from (a CDN in front of the bucket, or the bucket's public URL).
MEDIA_BASE_URL=
# The same site as ONE exact https origin, no path, so the CSP img-src can allow it
# (e.g. https://cdn.example.com). The web container refuses to start on anything else.
MEDIA_CDN_ORIGIN=

# Django admin (/admin/): off by default in production. When enabled, staff with two-step
# verification must enter a code at its login too.
ADMIN_ENABLED=False

# Web
WEB_PORT=80
# Same-origin via nginx proxy; override for a split frontend/backend deploy
VITE_API_URL=/api/v1

# Links in outgoing emails + OG tags point here (no trailing slash).
# Realtime sockets are accepted only from this origin and CSRF_TRUSTED_ORIGINS.
FRONTEND_URL=http://localhost

# Error tracking (leave empty to disable Sentry)
SENTRY_DSN=

# Email — defaults to console backend (logs only); set SMTP for real delivery
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexus <noreply@example.com>

# Account emails are processed by the Compose worker (same DB/SMTP environment).
# Per SMTP socket operation; keep below the worker's 60s stop grace.
EMAIL_TIMEOUT=30
EMAIL_USE_TLS=True
# Worker maintenance runs at startup and hourly; manual cleanup:
# docker compose -f docker-compose.prod.yml exec worker python manage.py prune_db_task_results --min-age-days 14 --failed-min-age-days 30
