# ──────────────────────────────────────────────
# docker-compose.prod.yml — copy to .env and edit
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# ──────────────────────────────────────────────

# Django
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origin(s) the SPA is served from (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
# Set True once TLS is terminated in front of nginx
SECURE_SSL_REDIRECT=False

# PostgreSQL
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=change-me-strong-password

# Web
WEB_PORT=80
# Same-origin via nginx proxy; override for a split frontend/backend deploy
VITE_API_URL=/api/v1

# Links in outgoing emails + OG tags point here (no trailing slash)
FRONTEND_URL=http://localhost

# Error tracking (leave empty to disable Sentry)
SENTRY_DSN=

# Email — defaults to console backend (logs only); set SMTP for real delivery
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexus <noreply@example.com>
