# ──────────────────────────────────────────────
# Django
# ──────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
NUM_PROXIES=0

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=nexus
DB_HOST=localhost
DB_PORT=5432

# ──────────────────────────────────────────────
# CORS — frontend dev server origin
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────────────
# SimpleJWT (saniye)
# ──────────────────────────────────────────────
JWT_ACCESS_LIFETIME=900
JWT_REFRESH_LIFETIME=604800

# ──────────────────────────────────────────────
# E-posta (dev'de console backend: mailler terminale yazılır)
# ──────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Nexus <noreply@example.com>

# E-postadaki linkler ve OG etiketleri bu adrese işaret eder
FRONTEND_URL=http://localhost:5173

# Realtime (WebSocket): needs Redis (docker compose up -d redis) and a second process:
#   DJANGO_SETTINGS_MODULE=config.settings.dev uvicorn config.asgi:application --reload --port 8001 --ws websockets-sansio
# Without REDIS_URL realtime is off and the SPA keeps polling.
# REDIS_URL=redis://localhost:6379/1

# Two-step verification (TOTP): empty keeps it off. Generate a key with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEY=
# MFA_ISSUER=Nexus
# Django admin: on in dev by default, off in production unless ADMIN_ENABLED=True.
# ADMIN_ENABLED=True

# Account emails are queued in PostgreSQL; run in a second terminal:
# python manage.py db_worker --no-reload
# Per SMTP socket operation; keep below the production worker's 60s stop grace.
EMAIL_TIMEOUT=30
EMAIL_USE_TLS=True
# Production worker maintenance runs at startup and hourly; local manual cleanup:
# python manage.py prune_db_task_results --min-age-days 14 --failed-min-age-days 30
