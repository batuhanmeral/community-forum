# ──────────────────────────────────────────────
# Django
# ──────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=nexus
DB_HOST=localhost
DB_PORT=5432

# ──────────────────────────────────────────────
# CORS — frontend dev server origin
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────────────
# SimpleJWT (saniye)
# ──────────────────────────────────────────────
JWT_ACCESS_LIFETIME=900
JWT_REFRESH_LIFETIME=604800

# ──────────────────────────────────────────────
# E-posta (dev'de console backend: mailler terminale yazılır)
# ──────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Nexus <noreply@example.com>

# E-postadaki linkler ve OG etiketleri bu adrese işaret eder
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Medya (prod'da S3 ayarları eklenir)
# ──────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
